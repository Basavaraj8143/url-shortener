# Copy this file to .env and fill in real values before running:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener
DB_USERNAME=postgres
DB_PASSWORD=local_dev_password
DB_SSL_MODE=disable

# For Neon, copy the pooled connection details from the Connect dialog.
# DB_HOST=<Neon pooled hostname ending in -pooler...>
# DB_PORT=5432
# DB_NAME=<database from connection string>
# DB_USERNAME=<role from connection string>
# DB_PASSWORD=<Neon role password>
# DB_SSL_MODE=require
# DB_POOL_MAX=5

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random string (min 64 chars recommended)
JWT_SECRET=replace-this-with-a-very-long-random-secret-key-at-least-64-chars

# Clerk API Keys page → Frontend API domain.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Frontend origins allowed to authenticate with Clerk and call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
