# Copy this file to .env and fill in real values before running:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────
DB_NAME=url_shortener
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random string (min 64 chars recommended)
JWT_SECRET=replace-this-with-a-very-long-random-secret-key-at-least-64-chars
